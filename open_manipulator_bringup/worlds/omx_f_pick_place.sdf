<?xml version="1.0"?>
<sdf version="1.10">
  <world name="omx_f_pick_place">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.82 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.5 0.2 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The tabletop upper surface is z=0, matching the robot's original spawn height. -->
    <model name="work_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="table">
        <collision name="top_collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
          <material><ambient>0.42 0.24 0.1 1</ambient><diffuse>0.55 0.32 0.14 1</diffuse></material>
        </visual>
        <collision name="leg_fl_collision"><pose>-0.5 0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry></collision>
        <visual name="leg_fl_visual"><pose>-0.5 0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="leg_fr_collision"><pose>-0.5 -0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry></collision>
        <visual name="leg_fr_visual"><pose>-0.5 -0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="leg_rl_collision"><pose>0.5 0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry></collision>
        <visual name="leg_rl_visual"><pose>0.5 0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="leg_rr_collision"><pose>0.5 -0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry></collision>
        <visual name="leg_rr_visual"><pose>0.5 -0.3 -0.4 0 0 0</pose><geometry><box><size>0.06 0.06 0.7</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dynamic grasp target: 50 mm cube, initially in front of the robot. -->
    <model name="pick_cube">
      <pose>0.28 0.02 0.035 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0000208333</ixx><iyy>0.0000208333</iyy><izz>0.0000208333</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.85 0.08 0.06 1</ambient><diffuse>0.95 0.1 0.08 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Open-top destination bin. Inner area is approximately 160 x 140 mm. -->
    <model name="place_bin">
      <static>true</static>
      <pose>0.32 -0.16 0 0 0 0</pose>
      <link name="bin_link">
        <collision name="floor_collision"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.2 0.18 0.02</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.2 0.18 0.02</size></box></geometry><material><diffuse>0.1 0.35 0.85 1</diffuse></material></visual>
        <collision name="left_wall_collision"><pose>0 0.08 0.06 0 0 0</pose><geometry><box><size>0.2 0.02 0.12</size></box></geometry></collision>
        <visual name="left_wall_visual"><pose>0 0.08 0.06 0 0 0</pose><geometry><box><size>0.2 0.02 0.12</size></box></geometry><material><diffuse>0.1 0.35 0.85 1</diffuse></material></visual>
        <collision name="right_wall_collision"><pose>0 -0.08 0.06 0 0 0</pose><geometry><box><size>0.2 0.02 0.12</size></box></geometry></collision>
        <visual name="right_wall_visual"><pose>0 -0.08 0.06 0 0 0</pose><geometry><box><size>0.2 0.02 0.12</size></box></geometry><material><diffuse>0.1 0.35 0.85 1</diffuse></material></visual>
        <collision name="front_wall_collision"><pose>0.09 0 0.06 0 0 0</pose><geometry><box><size>0.02 0.14 0.12</size></box></geometry></collision>
        <visual name="front_wall_visual"><pose>0.09 0 0.06 0 0 0</pose><geometry><box><size>0.02 0.14 0.12</size></box></geometry><material><diffuse>0.1 0.35 0.85 1</diffuse></material></visual>
        <collision name="back_wall_collision"><pose>-0.09 0 0.06 0 0 0</pose><geometry><box><size>0.02 0.14 0.12</size></box></geometry></collision>
        <visual name="back_wall_visual"><pose>-0.09 0 0.06 0 0 0</pose><geometry><box><size>0.02 0.14 0.12</size></box></geometry><material><diffuse>0.1 0.35 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>1.25 -1.35 1.35 0 0.45 2.35</pose>
      </camera>
    </gui>
  </world>
</sdf>
