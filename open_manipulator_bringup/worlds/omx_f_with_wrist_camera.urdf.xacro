<?xml version="1.0"?>
<robot name="omx_f_with_wrist_camera" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Keep the upstream OMX-F model intact and extend it only for simulation. -->
  <xacro:include filename="$(find open_manipulator_description)/urdf/omx_f/omx_f.urdf.xacro"/>

  <joint name="wrist_camera_joint" type="fixed">
    <parent link="link5"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0.025 0 0.045" rpy="0 0 0"/>
  </joint>

  <link name="wrist_camera_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry><box size="0.025 0.04 0.025"/></geometry>
      <material name="camera_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
  </link>

  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/omx_f/wrist_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.02</near><far>5.0</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
